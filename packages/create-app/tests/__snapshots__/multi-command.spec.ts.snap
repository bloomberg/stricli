        "test-cli": "dist/cli.js",
        "__test-cli_bash_complete": "dist/bash-complete.js"
    },
    "engines": {},
    "scripts": {
        "prebuild": "tsc -p src/tsconfig.json",
        "build": "tsup --silent",
