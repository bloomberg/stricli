{
    "name": "@org/test-cli",
    "author": "",
    "description": "Stricli command line application",
    "license": "MIT",
    "type": "module",
    "version": "0.0.0",
    "files": [
        "dist"
    ],
    "bin": {
        "@org/test-cli": "dist/cli.js",
        "__@org/test-cli_bash_complete": "dist/bash-complete.js"
    },
    "engines": {},
    "scripts": {
        "prebuild": "tsc -p src/tsconfig.json",
        "build": "tsup --silent",
        "prepublishOnly": "npm run build",
        "postinstall": "@org/test-cli install"
    },
    "tsup": {
        "entry": [
            "src/bin/cli.ts",
            "src/bin/bash-complete.ts"
        ],
        "format": [
            "esm"
        ],
        "tsconfig": "src/tsconfig.json",
        "clean": true,
        "splitting": true,
        "minify": true
    },
    "dependencies": {
        "@stricli/core": "^1.3.0",
        "@stricli/auto-complete": "^1.3.0"
    },
    "devDependencies": {
        "tsup": "^6.7.0",
        "typescript": "5.6.x"
    }
}
